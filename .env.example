# ==========================================
# VOTEX PROTOCOL ENVIRONMENT CONFIGURATION
# ==========================================

# Blockchain Network (Polygon Amoy Testnet)
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology/
NEXT_PUBLIC_BLOCK_EXPLORER=https://amoy.polygonscan.com

# Deployed Smart Contract Addresses on Polygon Amoy
NEXT_PUBLIC_MANAGER_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
NEXT_PUBLIC_CONTRACT_ADDRESS=0x34A60E36f1c48F4f8d4862e3E2F4d4c5145b23d9

# Web3 WalletConnect Cloud Project ID (get at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=3a8170812b534d0ff9d794f19a901d64

# PostgreSQL Database (Supabase PostgreSQL Recommended)
# Local demo mode runs gracefully with in-memory persistence if DATABASE_URL is unset
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/votex?schema=public"

# SIWE Authentication Session Secret (HMAC-SHA256, min 32 chars)
AUTH_SECRET="votex_production_secret_key_change_me_to_a_random_32_bytes_string!"

# Supabase Storage & Services (Optional for Candidate Media)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Foundry Smart Contract Deployment Keys (NEVER COMMIT REAL SECRETS)
# POLYGONSCAN_API_KEY="your-polygonscan-api-key"
# PRIVATE_KEY="your-testnet-faucet-funded-deployer-private-key"
